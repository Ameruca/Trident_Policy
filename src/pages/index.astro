---
import Base from '../layouts/Base.astro';
---

<Base title="Trident" description="Trident: juego de bebida." lang="es">
  <main class="home">
    <img src="/icon.png" alt="Ícono de Trident" width="112" height="112" />
    <h1>Trident</h1>
    <p>Juego de bebidas.</p>
    <ul>
      <li><a href="/privacidad">Política de privacidad</a></li>
      <li><a href="/en/privacy" hreflang="en">Privacy Policy (English)</a></li>
    </ul>
  </main>
</Base>

<style>
  .home {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem clamp(1rem, 4vw, 2rem) 5rem;
    text-align: center;
  }

  img {
    border-radius: 26px;
  }

  h1 {
    margin: 1.25rem 0 0.25rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 8vw, 3.75rem);
    line-height: 1.05;
  }

  p {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    font-weight: 800;
    text-decoration: none;
  }

  a:hover {
    border-color: var(--amber);
  }
</style>
